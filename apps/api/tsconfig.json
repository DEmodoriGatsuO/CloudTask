{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@cloudtask/shared": ["../../packages/shared/src/index"],
